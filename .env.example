# Ningún valor real vive en este archivo. Solo nombres.
# Las claves se cargan exclusivamente en Vercel, del lado del servidor.

# --- Kapso -----------------------------------------------------------------
# Necesarias solo para responder. Sin ellas el servicio recibe y valida
# eventos, pero permanece en silencio.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Obligatoria siempre: sin secreto no se puede verificar la firma del webhook.
KAPSO_WEBHOOK_SECRET=

# --- Supabase --------------------------------------------------------------
# Obligatorias siempre: idempotencia, pausa e historial.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI (se integra en la Fase 3) --------------------------------------
OPENAI_API_KEY=
# Sin valor por defecto a propósito: el modelo se elige tras evaluar costo,
# latencia y calidad. Mientras esté vacío, el sistema no responde.
OPENAI_MODEL=
# Tiempo máximo de la decisión. Al agotarse, silencio.
OPENAI_TIMEOUT_MS=8000
OPENAI_MAX_OUTPUT_TOKENS=400

# --- Ventana corta de contexto ---------------------------------------------
# Lo que se cumpla primero. Suficiente para entender un seguimiento, sin
# convertirse en memoria larga.
CONTEXT_WINDOW_MESSAGES=6
CONTEXT_WINDOW_MINUTES=30

# --- Operación -------------------------------------------------------------
# Debe valer exactamente 'true' para que el sistema responda. Cualquier otro
# valor, o cualquier configuración incompleta, deja el servicio en silencio.
BUSINESS_RESPONSES_ENABLED=false

# Cada respuesta manual del dueño pausa solo ese chat por este tiempo.
HUMAN_PAUSE_MINUTES=30
